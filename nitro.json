{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "munimhaptics"
  ],
  "ios": {
    "iosModuleName": "MunimHaptics"
  },
  "android": {
    "androidNamespace": [
      "munimhaptics"
    ],
    "androidCxxLibName": "MunimHaptics"
  },
  "autolinking": {
    "MunimHaptics": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridMunimHaptics"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridMunimHaptics"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
